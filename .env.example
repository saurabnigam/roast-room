# Optional. The room works without this file: it plays councils you run in Claude Code.
#
# To let the room run councils by itself (billed to your Anthropic API account,
# about 25 calls per full council), copy this file to .env and fill in:

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# "viewer" (default) or "api"
COUNCIL_RUNNER=viewer

# Used by /newroaster to make a new advisor's cartoon portrait (about 5 image jobs each).
# Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=

# Mixed panel: run some seats on other models, or add real people. All optional.
# A seat on OpenAI or Google receives the brief and the round files. The Chair asks you first.
# The CLI fall-back needs codex and agy logged in with their own login. Secret-looking variables
# (*_API_KEY, *_TOKEN, *_SECRET, *_PASSWORD, *CREDENTIALS) are removed before the CLI starts.

# OpenAI API key, for seats you run on OpenAI. Without it, an OpenAI seat uses the Codex CLI if DELEGATE_PY is set.
OPENAI_API_KEY=
# Google Gemini API key, for seats you run on Google. Without it, a Google seat uses the agy CLI if DELEGATE_PY is set.
GEMINI_API_KEY=
# Model for a seat on OpenAI when the seat names none. Default: gpt-6.1-sol
OPENAI_SEAT_MODEL=
# Model for a seat on Google when the seat names none. Default: gemini-3.8-flash
GEMINI_SEAT_MODEL=
# Model for a Claude seat when the room runs a council itself (COUNCIL_RUNNER=api) and the seat names none. Default: claude-sonnet-5-5. In Claude Code such a seat runs on your session's model.
SEAT_MODEL=
# Model for the Chair when the room runs a council by itself (COUNCIL_RUNNER=api). Default: claude-opus-5-5
CHAIR_MODEL=
# Absolute path to delegate.py. Turns on the Codex and agy CLI fall-back when Claude Code runs a council.
DELEGATE_PY=
# Python interpreter that runs delegate.py. Default: python3
DELEGATE_PYTHON=
# Minutes a person has to answer each round in the room's form. Default: 30 (a fraction is fine)
HUMAN_DEADLINE_MIN=
